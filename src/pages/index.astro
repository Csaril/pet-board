---
import '../styles/global.css';
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Локальная совместная доска для настольных ролевых игр" />
    <title>Tabletop Board</title>
  </head>
  <body>
    <main class="shell" id="login-shell">
      <section class="card" aria-labelledby="title">
        <div class="brand-mark" aria-hidden="true">TB</div>
        <p class="eyebrow">Совместная игровая доска</p>
        <h1 id="title">Подключиться к комнате</h1>
        <p class="intro">Введите имя и код комнаты. Ведущий использует пароль, заданный в настройках сервера.</p>
        <form id="join-form">
          <label for="name">Ваше имя</label>
          <input id="name" name="name" autocomplete="name" maxlength="40" required />
          <label for="roomCode">Код комнаты</label>
          <input id="roomCode" name="roomCode" autocomplete="off" maxlength="64" required />
          <label for="role">Роль</label>
          <select id="role" name="role">
            <option value="player">Игрок</option>
            <option value="gm">Ведущий</option>
          </select>
          <div id="gm-field" hidden>
            <label for="gmPassword">Пароль ведущего</label>
            <input id="gmPassword" name="gmPassword" type="password" autocomplete="current-password" />
          </div>
          <button type="submit">Подключиться</button>
          <p id="login-message" class="message" role="status" aria-live="polite"></p>
        </form>
      </section>
      <footer>Данные комнаты хранятся на компьютере ведущего</footer>
    </main>

    <main id="workspace" class="workspace" hidden>
      <header class="topbar">
        <div class="topbar-brand"><span class="brand-mark small" aria-hidden="true">TB</span><div><strong id="room-name">Игровая комната</strong><span id="identity" class="identity"></span></div></div>
        <div class="topbar-center">
          <button id="zoom-reset" class="tool-button" type="button" title="Вернуть масштаб к 100%">100%</button>
          <button id="fit-board" class="tool-button" type="button">Показать всё</button>
          <button id="dice-tools-toggle" class="tool-button" type="button" aria-controls="dice-tools-panel" aria-expanded="false">Инструменты бросков</button>
          <button id="dice-history-toggle" class="tool-button" type="button" aria-controls="dice-history-panel" aria-expanded="false">История <span id="dice-new-count" class="dice-new-count" hidden></span></button>
          <span id="connection" class="status"><i></i><span>Подключение…</span></span>
        </div>
        <div class="topbar-actions">
          <button id="sheets-toggle" class="tool-button" type="button" aria-controls="sheets-panel" aria-expanded="false">Листы</button>
          <button id="notes-toggle" class="tool-button gm-only" type="button" hidden>Заметки</button>
          <button id="note-create" class="tool-button gm-only" type="button" hidden>＋ Заметка</button>
          <button id="sticker-create" class="tool-button" type="button" hidden>＋ Стикер</button>
          <button id="library-toggle" class="tool-button gm-only" type="button" hidden>Библиотека</button>
          <button id="leave" class="tool-button secondary" type="button">Выйти</button>
        </div>
      </header>
      <div class="workspace-body">
        <section class="canvas-wrap" aria-label="Игровая доска">
          <div id="board-canvas"></div>
          <div class="canvas-hint">Колесо мыши — масштаб · перетаскивайте пустое место — перемещение доски</div>
          <div id="canvas-message" class="canvas-message" role="status" aria-live="polite"></div>
          <div id="lock-indicator" class="lock-indicator canvas-lock-indicator" hidden>🔒 Слой заблокирован</div>
          <div id="object-tools" class="object-tools" hidden>
            <span id="selection-name" class="selection-name">Изображение</span>
            <button id="duplicate-object" type="button" title="Дублировать">Дублировать</button>
            <button id="flip-x" type="button" title="Отразить по горизонтали">↔</button>
            <button id="flip-y" type="button" title="Отразить по вертикали">↕</button>
            <button id="crop-toggle" type="button">Обрезать</button>
            <button id="crop-reset" type="button" hidden>Сбросить обрезку</button>
            <button id="crop-confirm" type="button" hidden>Применить обрезку</button>
            <label class="stretch-toggle"><input id="free-stretch" type="checkbox" /> Свободный размер</label>
            <label class="player-move gm-only"><input id="allow-player-move" type="checkbox" /> Разрешить игрокам двигать</label>
            <label class="move-layer gm-only">Слой <select id="object-layer"></select></label>
            <button id="object-back" class="gm-only" type="button">Назад</button>
            <button id="object-front" class="gm-only" type="button">Вперёд</button>
            <button id="delete-object" class="danger gm-only" type="button">Удалить</button>
            <button id="crop-cancel" type="button" hidden>Отмена</button>
          </div>
          <div id="sticker-tools" class="object-tools sticker-tools" hidden>
            <span class="selection-name">Стикер</span>
            <button id="sticker-edit" type="button">Текст</button>
            <label class="sticker-color-control">Фон <select id="sticker-bg"><option value="butter">Светлый</option><option value="rose">Розовый</option><option value="sky">Голубой</option><option value="sage">Зелёный</option></select></label>
            <label class="sticker-color-control">Размер <select id="sticker-font-size"><option>12</option><option>14</option><option>16</option><option>18</option><option>24</option><option>32</option><option>40</option></select></label>
            <label class="sticker-color-control">Цвет <select id="sticker-text-color"><option value="black">Чёрный</option><option value="white">Белый</option></select></label>
            <button id="sticker-duplicate" type="button">Дублировать</button>
            <button id="sticker-delete" class="danger" type="button">Удалить</button>
          </div>
          <div id="marker-tools" class="object-tools marker-tools" hidden>
            <span class="selection-name">Метка заметки</span>
            <button id="marker-edit" type="button">Редактировать заметку</button>
            <button id="marker-delete" class="danger" type="button">Удалить метку</button>
          </div>
          <div id="note-place-hint" class="canvas-message" role="status" hidden>Нажмите на доске, чтобы поставить метку заметки · Esc — отмена</div>
          <aside id="dice-tools-panel" class="floating-dice-panel dice-tools-panel" aria-label="Инструменты бросков" hidden>
            <div class="dice-panel-heading" data-panel-drag-handle><span class="panel-grip" aria-hidden="true">⠿</span><div class="panel-title"><p class="eyebrow">Игровые броски</p><h2>Инструменты</h2></div><button id="dice-tools-reset" class="icon-button panel-reset" type="button" title="Вернуть панель на место" aria-label="Вернуть панель инструментов на место">⌖</button><button id="dice-tools-close" class="icon-button" type="button" aria-label="Закрыть инструменты бросков">×</button></div>
            <div class="dice-room-system"><label for="room-system">Система комнаты</label><select id="room-system" disabled><option value="none">Без системы</option><option value="pbta-2d6">PbtA</option></select><button id="room-system-save" type="button" hidden>Применить</button></div>
            <div id="pbta-controls-home">
              <section id="pbta-roll-controls" class="dice-roll-controls" hidden aria-label="Проверка PbtA">
                <h3>Проверка PbtA</h3>
                <label for="pbta-bonus">Бонус характеристики</label><input id="pbta-bonus" type="number" min="-1000" max="1000" value="0" />
                <label for="pbta-modifier">Ситуационный модификатор</label><select id="pbta-modifier"><option value="0">Без модификатора</option><option value="1">Превосходство (+1)</option><option value="-1">Угнетение (-1)</option></select>
                <label class="dice-checkbox"><input id="pbta-disadvantage" type="checkbox" /> Помеха</label>
                <label id="pbta-actor-row" for="pbta-actor" hidden>Бросок за игрока</label><select id="pbta-actor" hidden></select>
                <button id="pbta-roll" type="button">Бросить 2d6</button>
              </section>
            </div>
            <section class="dice-roll-controls" aria-label="Свободный бросок">
              <h3>Свободный бросок</h3>
              <div class="free-dice-fields"><label for="free-count">Кубиков</label><input id="free-count" type="number" min="1" max="20" value="1" /><label for="free-sides">Тип</label><select id="free-sides"><option>4</option><option selected>6</option><option>8</option><option>10</option><option>12</option><option>20</option><option>100</option></select></div>
              <button id="free-roll" class="secondary" type="button">Бросить</button>
            </section>
          </aside>
          <aside id="dice-history-panel" class="floating-dice-panel dice-history-panel" aria-label="История бросков" hidden>
            <div class="dice-panel-heading" data-panel-drag-handle><span class="panel-grip" aria-hidden="true">⠿</span><div class="panel-title"><p class="eyebrow">Общая лента</p><h2>История бросков</h2></div><button id="dice-history-reset" class="icon-button panel-reset" type="button" title="Вернуть панель на место" aria-label="Вернуть историю бросков на место">⌖</button><button id="dice-history-close" class="icon-button" type="button" aria-label="Закрыть историю бросков">×</button></div>
            <ul id="dice-history" class="dice-history" aria-live="polite"></ul>
          </aside>
        </section>

        <div id="layers-dock" class="layers-dock gm-only" hidden>
          <aside id="layers-panel" class="side-panel layers-panel">
            <div class="panel-heading"><div><p class="eyebrow">Рабочее пространство</p><h2>Слои</h2></div><div class="layers-heading-actions"><button id="layer-create" class="icon-button" type="button" aria-label="Создать слой">＋</button><button id="layers-collapse" class="icon-button" type="button" aria-label="Свернуть панель слоёв" title="Свернуть панель">‹</button></div></div>
            <p class="panel-note">Слои сверху списка отображаются поверх остальных.</p>
            <ul id="layers-list" class="layers-list"></ul>
          </aside>
          <button id="layers-expand" class="layers-expand" type="button" aria-label="Развернуть панель слоёв" title="Развернуть слои" hidden>▤</button>
        </div>
      </div>

      <aside id="library-panel" class="library-panel" hidden>
        <div class="panel-heading"><div><p class="eyebrow">Изображения</p><h2>Библиотека ресурсов</h2></div><button id="library-close" class="icon-button" type="button" aria-label="Закрыть библиотеку">×</button></div>
        <label class="upload-button" for="image-upload">Загрузить изображение</label>
        <input id="image-upload" type="file" accept="image/png,image/jpeg,image/webp" multiple hidden />
        <div id="upload-drop-zone" class="upload-drop-zone" tabindex="0" role="button" aria-label="Перетащите сюда изображения для загрузки">
          Перетащите сюда одно или несколько изображений
        </div>
        <p class="panel-note">PNG, JPG или WebP · до <span id="upload-limit">25</span> MB</p>
        <p id="upload-message" class="message" role="status" aria-live="polite"></p>
        <ul id="assets-list" class="assets-list"></ul>
      </aside>

      <aside id="notes-panel" class="library-panel notes-panel gm-only" hidden>
        <div class="panel-heading"><div><p class="eyebrow">Подготовка игры</p><h2>Заметки</h2></div><button id="notes-close" class="icon-button" type="button" aria-label="Закрыть заметки">×</button></div>
        <ul id="notes-list" class="assets-list"></ul>
      </aside>

      <aside id="sheets-panel" class="library-panel sheets-panel" hidden>
        <div class="panel-heading"><div><p class="eyebrow">Персонажи</p><h2>Листы</h2></div><button id="sheets-close" class="icon-button" type="button" aria-label="Закрыть каталог листов">×</button></div>
        <p class="panel-note">Один игрок может иметь несколько листов. Назначенный лист редактирует игрок, любой лист — ведущий. Остальные участники могут только просматривать.</p>
        <ul id="sheets-list" class="sheets-list"></ul>
      </aside>
    </main>
    <dialog id="sticker-create-dialog" class="compact-dialog">
      <h2>Новый стикер</h2>
      <label for="sticker-new-text">Текст</label><textarea id="sticker-new-text" rows="4" maxlength="1000"></textarea>
      <label for="sticker-new-size">Размер текста</label><select id="sticker-new-size"><option>12</option><option>14</option><option>16</option><option selected>18</option><option>24</option><option>32</option><option>40</option></select>
      <label for="sticker-new-color">Цвет текста</label><select id="sticker-new-color"><option value="black">Чёрный</option><option value="white">Белый</option></select>
      <div class="note-dialog-actions"><button id="sticker-create-cancel" class="secondary" type="button">Отмена</button><button id="sticker-create-confirm" type="button">Создать</button></div>
    </dialog>
    <dialog id="note-dialog" class="note-dialog">
      <div class="note-dialog-heading"><div><p id="note-privacy" class="privacy-indicator">Личная заметка</p><h2 id="note-dialog-heading">Заметка</h2></div><button id="note-close" class="icon-button" type="button" aria-label="Закрыть заметку">×</button></div>
      <div class="note-editor-fields">
        <label for="note-title">Заголовок</label><input id="note-title" maxlength="120" />
        <label for="note-access">Доступ</label>
        <select id="note-access"><option value="gm-only">Только ведущий</option><option value="all-players">Все игроки</option><option value="selected-players">Выбранные игроки</option></select>
        <fieldset id="note-participants" class="note-participants" hidden><legend>Кому доступна заметка</legend><div id="note-participant-list"></div></fieldset>
        <label for="note-marker-type">Вид метки</label><select id="note-marker-type"><option value="text">Текстовая</option><option value="image">Изображение</option></select>
        <div id="note-marker-text-row"><label for="note-marker-text">Подпись метки (необязательно)</label><input id="note-marker-text" maxlength="60" placeholder="По умолчанию — название заметки" /></div>
        <div id="note-marker-image-row" hidden><button id="note-marker-image-pick" class="secondary" type="button">Выбрать изображение метки</button><span id="note-marker-image-name"></span></div>
        <label for="note-body">Текст</label><textarea id="note-body" rows="8" maxlength="20000"></textarea>
        <fieldset class="note-assets"><legend>Изображения заметки</legend><div id="note-selected-assets" class="note-selected-assets"></div><button id="note-add-image" class="secondary" type="button">Добавить изображение</button></fieldset>
      </div>
      <div id="note-view-images" class="note-view-images" hidden></div>
      <div id="note-view-body" class="note-view-body" hidden></div>
      <div class="note-dialog-actions"><button id="note-edit" type="button" hidden>Редактировать</button><button id="note-place-marker" type="button" hidden>Поставить метку</button><button id="note-save" type="button">Сохранить</button></div>
      <p id="note-message" class="message" role="status" aria-live="polite"></p>
    </dialog>
    <aside id="sheet-panel" class="floating-sheet-panel" aria-label="Лист персонажа" hidden>
      <div class="sheet-panel-heading" data-panel-drag-handle>
        <span class="panel-grip" aria-hidden="true">⠿</span>
        <div class="sheet-panel-identity">
          <div class="sheet-portrait-wrap">
            <img id="sheet-portrait" class="sheet-dialog-portrait" alt="" hidden />
            <span id="sheet-portrait-fallback" class="sheet-dialog-portrait sheet-portrait-fallback" aria-hidden="true"></span>
          </div>
          <div class="sheet-panel-title">
            <p id="sheet-owner" class="eyebrow"></p>
            <h2 id="sheet-name-heading">Лист персонажа</h2>
            <p id="sheet-system" class="panel-note"></p>
          </div>
        </div>
        <div class="sheet-panel-actions">
          <button id="sheet-edit-toggle" type="button">Редактировать</button>
          <button id="sheet-collapse" class="icon-button" type="button" aria-label="Свернуть лист" aria-expanded="true" title="Свернуть лист">–</button>
          <button id="sheet-close" class="icon-button" type="button" aria-label="Закрыть лист">×</button>
        </div>
      </div>
      <div id="sheet-panel-body" class="sheet-panel-body">
        <p id="sheet-message" class="message" role="status" aria-live="polite"></p>
        <div id="sheet-content" class="sheet-content"></div>
      </div>
    </aside>
    <aside id="sheet-roll-panel" class="sheet-roll-panel" aria-label="Окно броска по характеристике" hidden>
      <div class="sheet-roll-heading">
        <div>
          <p class="eyebrow">Проверка характеристики</p>
          <h2 id="sheet-roll-name">Характеристика</h2>
        </div>
        <button id="sheet-roll-close" class="icon-button" type="button" aria-label="Закрыть окно броска">×</button>
      </div>
      <div id="sheet-roll-controls" class="sheet-roll-controls"></div>
    </aside>
    <dialog id="asset-picker-dialog" class="asset-picker-dialog">
      <div class="note-dialog-heading"><div><p class="eyebrow">Общие ресурсы</p><h2>Изображения</h2></div><button id="asset-picker-close" class="icon-button" type="button" aria-label="Закрыть окно выбора">×</button></div>
      <div class="asset-picker-modes"><button id="asset-picker-library-mode" type="button" class="active">Библиотека</button><button id="asset-picker-upload-mode" type="button">Загрузить новое</button></div>
      <section id="asset-picker-library"><div id="asset-picker-grid" class="asset-picker-grid"></div></section>
      <section id="asset-picker-upload" hidden>
        <div id="note-image-drop-zone" class="note-image-drop-zone" tabindex="0" role="group" aria-label="Перетащите изображения в эту область или выберите файлы">
          <strong>Перетащите изображения сюда</strong><span>PNG, JPG или WebP · можно выбрать несколько файлов</span>
          <label class="upload-button" for="note-image-upload">Выбрать изображения</label>
          <input id="note-image-upload" type="file" accept="image/png,image/jpeg,image/webp" multiple hidden />
        </div>
        <ul id="note-image-upload-status" class="note-image-upload-status" aria-live="polite"></ul>
      </section>
      <div class="note-dialog-actions"><button id="asset-picker-cancel" class="secondary" type="button">Отмена</button><button id="asset-picker-add" type="button">Добавить выбранные</button></div>
    </dialog>
    <script>
      import '../client/app.ts';
    </script>
  </body>
</html>
