---
import '../styles/global.css';
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Локальная совместная доска для настольных ролевых игр" />
    <title>Tabletop Board</title>
  </head>
  <body>
    <main class="shell" id="login-shell">
      <section class="card" aria-labelledby="title">
        <div class="brand-mark" aria-hidden="true">TB</div>
        <p class="eyebrow">Совместная игровая доска</p>
        <h1 id="title">Подключиться к комнате</h1>
        <p class="intro">Введите имя и код комнаты. Ведущий использует пароль, заданный в настройках сервера.</p>
        <form id="join-form">
          <label for="name">Ваше имя</label>
          <input id="name" name="name" autocomplete="name" maxlength="40" required />
          <label for="roomCode">Код комнаты</label>
          <input id="roomCode" name="roomCode" autocomplete="off" maxlength="64" required />
          <label for="role">Роль</label>
          <select id="role" name="role">
            <option value="player">Игрок</option>
            <option value="gm">Ведущий</option>
          </select>
          <div id="gm-field" hidden>
            <label for="gmPassword">Пароль ведущего</label>
            <input id="gmPassword" name="gmPassword" type="password" autocomplete="current-password" />
          </div>
          <button type="submit">Подключиться</button>
          <p id="login-message" class="message" role="status" aria-live="polite"></p>
        </form>
      </section>
      <footer>Данные комнаты хранятся на компьютере ведущего</footer>
    </main>

    <main id="workspace" class="workspace" hidden>
      <header class="topbar">
        <div class="topbar-brand"><span class="brand-mark small" aria-hidden="true">TB</span><div><strong id="room-name">Игровая комната</strong><span id="identity" class="identity"></span></div></div>
        <div class="topbar-center">
          <button id="zoom-reset" class="tool-button" type="button" title="Вернуть масштаб к 100%">100%</button>
          <button id="fit-board" class="tool-button" type="button">Показать всё</button>
          <span id="connection" class="status"><i></i><span>Подключение…</span></span>
        </div>
        <div class="topbar-actions">
          <button id="notes-toggle" class="tool-button gm-only" type="button" hidden>Заметки</button>
          <button id="note-create" class="tool-button gm-only" type="button" hidden>＋ Заметка</button>
          <button id="sticker-create" class="tool-button" type="button" hidden>＋ Стикер</button>
          <button id="library-toggle" class="tool-button gm-only" type="button" hidden>Библиотека</button>
          <button id="leave" class="tool-button secondary" type="button">Выйти</button>
        </div>
      </header>
      <div class="workspace-body">
        <section class="canvas-wrap" aria-label="Игровая доска">
          <div id="board-canvas"></div>
          <div class="canvas-hint">Колесо мыши — масштаб · перетаскивайте пустое место — перемещение доски</div>
          <div id="canvas-message" class="canvas-message" role="status" aria-live="polite"></div>
          <div id="lock-indicator" class="lock-indicator canvas-lock-indicator" hidden>🔒 Слой заблокирован</div>
          <div id="object-tools" class="object-tools" hidden>
            <span id="selection-name" class="selection-name">Изображение</span>
            <button id="duplicate-object" type="button" title="Дублировать">Дублировать</button>
            <button id="flip-x" type="button" title="Отразить по горизонтали">↔</button>
            <button id="flip-y" type="button" title="Отразить по вертикали">↕</button>
            <button id="crop-toggle" type="button">Обрезать</button>
            <button id="crop-reset" type="button" hidden>Сбросить обрезку</button>
            <button id="crop-confirm" type="button" hidden>Применить обрезку</button>
            <label class="stretch-toggle"><input id="free-stretch" type="checkbox" /> Свободный размер</label>
            <label class="player-move gm-only"><input id="allow-player-move" type="checkbox" /> Разрешить игрокам двигать</label>
            <label class="move-layer gm-only">Слой <select id="object-layer"></select></label>
            <button id="object-back" class="gm-only" type="button">Назад</button>
            <button id="object-front" class="gm-only" type="button">Вперёд</button>
            <button id="delete-object" class="danger gm-only" type="button">Удалить</button>
            <button id="crop-cancel" type="button" hidden>Отмена</button>
          </div>
          <div id="sticker-tools" class="object-tools sticker-tools" hidden>
            <span class="selection-name">Стикер</span>
            <button id="sticker-edit" type="button">Текст</button>
            <label class="sticker-color-control">Фон <select id="sticker-bg"><option value="butter">Светлый</option><option value="rose">Розовый</option><option value="sky">Голубой</option><option value="sage">Зелёный</option></select></label>
            <label class="sticker-color-control">Текст <select id="sticker-text-color"><option value="ink">Тёмный</option><option value="plum">Сливовый</option></select></label>
            <button id="sticker-duplicate" type="button">Дублировать</button>
            <button id="sticker-delete" class="danger" type="button">Удалить</button>
          </div>
          <div id="marker-tools" class="object-tools marker-tools" hidden>
            <span class="selection-name">Метка заметки</span>
            <button id="marker-edit" type="button">Редактировать заметку</button>
            <button id="marker-delete" class="danger" type="button">Удалить метку</button>
          </div>
          <div id="note-place-hint" class="canvas-message" role="status" hidden>Нажмите на доске, чтобы поставить метку заметки · Esc — отмена</div>
        </section>

        <aside id="layers-panel" class="side-panel layers-panel gm-only" hidden>
          <div class="panel-heading"><div><p class="eyebrow">Рабочее пространство</p><h2>Слои</h2></div><button id="layer-create" class="icon-button" type="button" aria-label="Создать слой">＋</button></div>
          <p class="panel-note">Слои сверху списка отображаются поверх остальных.</p>
          <ul id="layers-list" class="layers-list"></ul>
        </aside>
      </div>

      <aside id="library-panel" class="library-panel" hidden>
        <div class="panel-heading"><div><p class="eyebrow">Изображения</p><h2>Библиотека ресурсов</h2></div><button id="library-close" class="icon-button" type="button" aria-label="Закрыть библиотеку">×</button></div>
        <label class="upload-button" for="image-upload">Загрузить изображение</label>
        <input id="image-upload" type="file" accept="image/png,image/jpeg,image/webp" multiple hidden />
        <div id="upload-drop-zone" class="upload-drop-zone" tabindex="0" role="button" aria-label="Перетащите сюда изображения для загрузки">
          Перетащите сюда одно или несколько изображений
        </div>
        <p class="panel-note">PNG, JPG или WebP · до <span id="upload-limit">25</span> MB</p>
        <p id="upload-message" class="message" role="status" aria-live="polite"></p>
        <ul id="assets-list" class="assets-list"></ul>
      </aside>

      <aside id="notes-panel" class="library-panel notes-panel gm-only" hidden>
        <div class="panel-heading"><div><p class="eyebrow">Подготовка игры</p><h2>Заметки</h2></div><button id="notes-close" class="icon-button" type="button" aria-label="Закрыть заметки">×</button></div>
        <label class="player-sticker-setting"><input id="allow-player-stickers" type="checkbox" /> Разрешить игрокам создавать стикеры</label>
        <ul id="notes-list" class="assets-list"></ul>
      </aside>
    </main>
    <dialog id="note-dialog" class="note-dialog">
      <div class="note-dialog-heading"><div><p id="note-privacy" class="privacy-indicator">Личная заметка</p><h2 id="note-dialog-heading">Заметка</h2></div><button id="note-close" class="icon-button" type="button" aria-label="Закрыть заметку">×</button></div>
      <div class="note-editor-fields">
        <label for="note-title">Заголовок</label><input id="note-title" maxlength="120" />
        <label for="note-access">Доступ</label>
        <select id="note-access"><option value="gm-only">Только ведущий</option><option value="all-players">Все игроки</option><option value="selected-players">Выбранные игроки</option></select>
        <fieldset id="note-participants" class="note-participants" hidden><legend>Кому доступна заметка</legend><div id="note-participant-list"></div></fieldset>
        <label for="note-body">Текст</label><textarea id="note-body" rows="8" maxlength="20000"></textarea>
        <fieldset class="note-assets"><legend>Изображения из библиотеки</legend><div id="note-asset-list"></div></fieldset>
      </div>
      <div id="note-view-images" class="note-view-images" hidden></div>
      <div id="note-view-body" class="note-view-body" hidden></div>
      <div class="note-dialog-actions"><button id="note-edit" type="button" hidden>Редактировать</button><button id="note-place-marker" type="button" hidden>Поставить метку</button><button id="note-save" type="button">Сохранить</button></div>
      <p id="note-message" class="message" role="status" aria-live="polite"></p>
    </dialog>
    <script>
      import '../client/app.ts';
    </script>
  </body>
</html>
