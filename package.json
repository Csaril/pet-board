{
  "name": "tabletop-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro build && tsx watch server/index.ts",
    "build": "astro build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist-server/server/index.js",
    "backup": "node dist-server/server/backup.js create",
    "backup:list": "node dist-server/server/backup.js list",
    "backup:restore": "node dist-server/server/backup.js restore",
    "room:migrate": "node dist-server/server/room-migrate.js",
    "rooms:init": "node dist-server/server/rooms.js init",
    "rooms:create": "node dist-server/server/rooms.js create",
    "rooms:list": "node dist-server/server/rooms.js list",
    "rooms:disable": "node dist-server/server/rooms.js disable",
    "rooms:enable": "node dist-server/server/rooms.js enable",
    "rooms:archive": "node dist-server/server/rooms.js archive",
    "rooms:delete": "node dist-server/server/rooms.js delete",
    "rooms:migrate-system": "node dist-server/server/system-migrate.js",
    "catalog:backup": "node dist-server/server/catalog-cli.js backup",
    "catalog:list": "node dist-server/server/catalog-cli.js list",
    "catalog:restore": "node dist-server/server/catalog-cli.js restore",
    "install:backup": "node dist-server/server/catalog-cli.js install",
    "install:list": "node dist-server/server/catalog-cli.js install-list",
    "install:verify": "node dist-server/server/catalog-cli.js verify-install",
    "typecheck": "astro check && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test server/*.test.ts src/modules/system/pbta-2d6/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.2.0",
    "astro": "^7.4.7",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.5.0",
    "konva": "^10.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "ws": "^8.22.2"
  }
}
