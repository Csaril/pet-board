{
  "name": "tabletop-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro build && tsx watch server/index.ts",
    "build": "astro build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "backup": "node dist-server/server/backup.js",
    "typecheck": "astro check && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.2.0",
    "astro": "^7.4.7",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "ws": "^8.22.2"
  }
}
