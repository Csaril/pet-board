NODE_ENV=development
HOST=127.0.0.1
PORT=4321
APP_DATA_DIR=./data
# ROOM_* нужны только команде `npm run rooms:init` для регистрации существующей
# комнаты default. После инициализации обычный сервер их не использует.
ROOM_NAME=НРИ
ROOM_CODE=K7M2R9TX
GM_PASSWORD=quiet-forest
SESSION_DAYS=30
MAX_UPLOAD_MB=25
# Максимум одновременно открытых SQLite комнат (1–64).
MAX_OPEN_ROOMS=8
# Публичный адрес туннеля, например https://example.ngrok-free.app. Можно указать несколько через запятую.
PUBLIC_ORIGIN=
# Включайте только если сервер доступен исключительно через локальный обратный прокси (ngrok).
TRUST_PROXY=false
