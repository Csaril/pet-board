{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-server",
    "rootDir": ".",
    "noEmit": false,
    "types": ["node"],
    "allowImportingTsExtensions": false
  },
  "include": ["server/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["server/**/*.test.ts"]
}
